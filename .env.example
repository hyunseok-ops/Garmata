# Read-only Postgres URL for Garage listings (use a read-only role; never commit .env)
GARAGE_DATABASE_URL=postgresql://user:pass@host:5432/postgres
# Meshy API key for multi-image-to-3D generation
MESHY_API_KEY=
# Optional: write-through to Garage (admin oRPC). GARAGE_API_KEY is a Clerk admin API key ("ak_..."). Local backend: http://localhost:3001
GARAGE_API_URL=
GARAGE_API_KEY=
